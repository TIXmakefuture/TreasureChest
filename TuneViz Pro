<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>旋律Pro · TuneViz PRO</title>
  <style>
    :root {
      --bg-deep: #080810;
      --card-bg: rgba(16, 16, 26, 0.65);
      --card-border: rgba(255, 255, 255, 0.08);
      --text-primary: #f2f2f7;
      --text-secondary: #9898a8;
      --accent: #5e9eff;
      --progress-track: rgba(255, 255, 255, 0.12);
      --progress-fill: #ffffff;
      --radius-xl: 20px;
      --radius-lg: 14px;
      --radius-md: 10px;
      --transition-fast: 0.18s cubic-bezier(0.4, 0, 0.2, 1);
      --font-mono: 'SF Mono', 'JetBrains Mono', 'Consolas', 'Menlo', monospace;
      --white-a06: rgba(255, 255, 255, 0.06);
      --white-a08: rgba(255, 255, 255, 0.08);
      --white-a12: rgba(255, 255, 255, 0.12);
      --white-a15: rgba(255, 255, 255, 0.15);
      --white-a25: rgba(255, 255, 255, 0.25);
      --white-a04: rgba(255, 255, 255, 0.04);
      --white-a03: rgba(255, 255, 255, 0.03);
      --black-a25: rgba(0, 0, 0, 0.25);
      --black-a40: rgba(0, 0, 0, 0.4);
      --pro-bg: #0a0e14;
      --pro-panel: rgba(20, 24, 32, 0.9);
      --pro-border: rgba(255, 255, 255, 0.15);
      --pro-accent: #00e5ff;
      --pro-text: #e0e0e0;
      --pro-secondary: #888899;
    }
    body.light-theme {
      --bg-deep: #e8e8f0;
      --card-bg: rgba(255, 255, 255, 0.75);
      --card-border: rgba(0, 0, 0, 0.1);
      --text-primary: #1a1a1a;
      --text-secondary: #6e6e7a;
      --accent: #007aff;
      --progress-track: rgba(0, 0, 0, 0.12);
      --progress-fill: #333;
      --white-a06: rgba(0, 0, 0, 0.05);
      --white-a08: rgba(0, 0, 0, 0.08);
      --white-a12: rgba(0, 0, 0, 0.1);
      --white-a15: rgba(0, 0, 0, 0.12);
      --white-a25: rgba(0, 0, 0, 0.2);
      --white-a04: rgba(0, 0, 0, 0.03);
      --white-a03: rgba(0, 0, 0, 0.02);
      --black-a25: rgba(0, 0, 0, 0.1);
      --black-a40: rgba(0, 0, 0, 0.2);
    }
    * { margin:0; padding:0; box-sizing:border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'PingFang SC', sans-serif;
      background: var(--bg-deep); height:100vh; width:100vw; display:flex; align-items:center; justify-content:center;
      overflow:hidden; user-select:none; -webkit-user-select:none; -webkit-tap-highlight-color:transparent;
      perspective:2500px; position:relative; transition:background 0.4s;
    }
    .bg-orb { position:fixed; border-radius:50%; filter:blur(140px); opacity:0.35; pointer-events:none; z-index:0; will-change:transform; }
    .bg-orb--1 { width:600px; height:600px; background:#4dabff; top:-25%; left:-18%; transform:translateZ(-200px); }
    .bg-orb--2 { width:500px; height:500px; background:#0066cc; top:55%; right:-20%; transform:translateZ(-180px); }
    .bg-orb--3 { width:450px; height:450px; background:#003d99; bottom:-25%; left:30%; transform:translateZ(-160px); }
    .bg-orb--4 { width:320px; height:320px; background:#66c2ff; top:20%; right:35%; opacity:0.25; transform:translateZ(-140px); }

    .app-stage { position:relative; z-index:1; width:100%; height:100%; display:flex; align-items:center; justify-content:center; transform-style:preserve-3d; }

    /* ========== 经典版3D分层布局 ========== */
    #classicUI {
      width:92vw; max-width:1100px; max-height:94vh; display:flex; flex-direction:column; gap:0;
      transform-style:preserve-3d; transition:transform 0.1s ease-out; will-change:transform;
    }

    /* 底板 - 最远的层 */
    .layer-base {
      background: var(--card-bg); backdrop-filter:blur(50px) saturate(180%); -webkit-backdrop-filter:blur(50px) saturate(180%);
      border:1px solid var(--card-border); border-radius:var(--radius-xl);
      position:absolute; inset:-10px; z-index:0;
      transform:translateZ(-30px); box-shadow:0 50px 100px rgba(0,0,0,0.5);
    }
    .layer-base::after {
      content:''; position:absolute; inset:0; border-radius:inherit;
      background:linear-gradient(135deg, rgba(255,255,255,0.03) 0%, transparent 50%, rgba(255,255,255,0.02) 100%);
    }

    /* 可视化面板 - 最突出的层 */
    .layer-viz {
      position:relative; z-index:10; transform:translateZ(40px);
      margin-bottom:8px; border-radius:var(--radius-lg); overflow:hidden;
      background:#000; border:1px solid rgba(255,255,255,0.1);
      box-shadow:0 25px 60px rgba(0,0,0,0.6);
      height:340px; flex-shrink:0;
    }
    .layer-viz canvas { width:100%; height:100%; display:block; border-radius:var(--radius-lg); }
    .viz-mode-selector { position:absolute; top:10px; right:10px; display:flex; gap:5px; z-index:20; transform-style:preserve-3d; }
    .viz-mode-btn {
      width:30px; height:30px; border-radius:7px; border:1px solid rgba(255,255,255,0.2);
      background:rgba(0,0,0,0.5); color:rgba(255,255,255,0.7); font-size:15px; cursor:pointer;
      display:flex; align-items:center; justify-content:center; transition:all 0.18s;
      transform:translateZ(8px); box-shadow:0 4px 10px rgba(0,0,0,0.4);
    }
    .viz-mode-btn.active { background:rgba(255,255,255,0.25); border-color:#fff; color:#fff; transform:translateZ(12px); box-shadow:0 6px 16px rgba(0,0,0,0.5); }
    .fullscreen-btn {
      width:30px; height:30px; border-radius:7px; border:1px solid rgba(255,255,255,0.2);
      background:rgba(0,0,0,0.5); color:rgba(255,255,255,0.7); font-size:16px; cursor:pointer;
      display:flex; align-items:center; justify-content:center; transition:all 0.18s;
      transform:translateZ(8px); box-shadow:0 4px 10px rgba(0,0,0,0.4);
    }
    .fullscreen-btn:hover { background:rgba(255,255,255,0.2); color:#fff; transform:translateZ(14px); }

    /* 中间行：信息+列表 */
    .layer-middle {
      position:relative; z-index:6; display:flex; gap:10px;
      transform:translateZ(18px); flex:1; min-height:0; margin-bottom:8px;
    }
    /* 歌曲信息卡片 */
    .layer-info {
      flex:0 0 280px; background:var(--card-bg); backdrop-filter:blur(30px);
      border:1px solid var(--card-border); border-radius:var(--radius-md);
      padding:14px 16px; box-shadow:0 12px 30px rgba(0,0,0,0.4);
      transform:translateZ(8px); display:flex; flex-direction:column; gap:8px;
    }
    .track-title { font-size:19px; font-weight:600; color:var(--text-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .track-artist { font-size:13px; color:var(--text-secondary); }
    .track-meta { display:flex; gap:14px; font-size:11px; color:var(--text-secondary); }
    .progress-box { margin-top:6px; }
    .time-row { display:flex; justify-content:space-between; font-size:11px; color:var(--text-secondary); font-family:var(--font-mono); margin-bottom:4px; }
    .progress-bar { height:5px; background:var(--progress-track); border-radius:3px; cursor:pointer; position:relative; }
    .progress-fill { height:100%; background:var(--progress-fill); border-radius:3px; width:0%; transition:width 0.05s linear; box-shadow:0 0 10px var(--progress-fill); }

    /* 右侧面板：标签+列表 */
    .layer-right {
      flex:1; min-width:0; display:flex; flex-direction:column; gap:8px;
      transform:translateZ(4px);
    }
    .tabs-row { display:flex; gap:4px; background:var(--white-a04); border-radius:10px; padding:3px; }
    .tab-btn {
      flex:1; padding:9px 6px; border:none; background:transparent; color:var(--text-secondary);
      font-size:12px; font-weight:500; border-radius:8px; cursor:pointer; transition:all 0.18s;
    }
    .tab-btn.active { background:var(--white-a15); color:var(--text-primary); }
    .tab-content {
      flex:1; overflow-y:auto; border-radius:var(--radius-md); background:var(--black-a25);
      padding:6px; min-height:0; -webkit-overflow-scrolling:touch;
      box-shadow:inset 0 2px 8px rgba(0,0,0,0.2);
    }
    .playlist-item {
      display:flex; align-items:center; gap:8px; padding:8px 10px; border-radius:10px;
      cursor:pointer; background:var(--white-a03); border:1px solid transparent;
      transition:all 0.15s; font-size:12px;
    }
    .playlist-item:hover { background:var(--white-a06); border-color:var(--white-a08); }
    .playlist-item.active { background:var(--accent); border-color:var(--accent); color:#fff; }
    .playlist-item.active .playlist-item-title { color:#fff; }
    .playlist-item-index { width:20px; text-align:center; font-weight:500; color:var(--text-secondary); }
    .playlist-item-info { flex:1; min-width:0; }
    .playlist-item-title { color:var(--text-primary); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .playlist-item-artist { font-size:10px; color:var(--text-secondary); }
    .playlist-item-duration { font-family:var(--font-mono); font-size:10px; color:var(--text-secondary); }
    .playlist-item-type { font-size:13px; margin-right:2px; flex-shrink:0; }
    .playlist-item-del { background:none; border:none; color:var(--text-secondary); cursor:pointer; font-size:16px; padding:3px; border-radius:50%; }
    .playlist-item-del:hover { background:rgba(255,80,80,0.2); color:#ff5a5a; }
    .lyric-line { text-align:center; padding:5px 8px; color:var(--text-secondary); font-size:13px; transition:all 0.3s; border-radius:6px; }
    .lyric-line.active { color:var(--text-primary); background:var(--white-a08); font-weight:500; }

    /* 均衡器层 */
    .layer-eq {
      position:relative; z-index:5; transform:translateZ(22px);
      margin-bottom:8px; padding:10px 14px; background:var(--black-a25); border-radius:14px;
      display:flex; align-items:flex-end; gap:6px; justify-content:space-around;
      height:85px; flex-shrink:0; box-shadow:0 10px 25px rgba(0,0,0,0.4);
      border:1px solid rgba(255,255,255,0.05);
    }
    .eq-slider-group { display:flex; flex-direction:column; align-items:center; gap:3px; }
    .eq-slider { -webkit-appearance:slider-vertical; width:22px; height:60px; background:transparent; }
    .eq-label { font-size:9px; color:var(--text-secondary); }

    /* 控制栏 - 最前层 */
    .layer-controls {
      position:relative; z-index:12; display:flex; align-items:center; justify-content:center;
      gap:14px; padding:8px 0 4px; flex-shrink:0;
      transform:translateZ(50px);
    }
    .ctrl-btn {
      width:42px; height:42px; border-radius:50%; background:var(--white-a06); border:none;
      color:var(--text-primary); cursor:pointer; display:flex; align-items:center; justify-content:center;
      transition:all 0.15s; font-size:17px;
      transform:translateZ(15px); box-shadow:0 8px 20px rgba(0,0,0,0.4);
    }
    .ctrl-btn:hover { background:var(--white-a12); transform:translateZ(22px) scale(1.05); box-shadow:0 12px 28px rgba(0,0,0,0.5); }
    .ctrl-btn:active { transform:translateZ(8px) scale(0.9); }
    .play-btn {
      width:56px; height:56px; background:var(--text-primary); color:var(--bg-deep);
      transform:translateZ(20px); box-shadow:0 10px 25px rgba(0,0,0,0.5);
    }
    .play-btn:hover { transform:translateZ(28px) scale(1.05); box-shadow:0 16px 35px rgba(0,0,0,0.6); }
    .pan-slider { width:80px; -webkit-appearance:none; height:4px; background:var(--progress-track); border-radius:2px; outline:none; transform:translateZ(10px); }
    .pan-slider::-webkit-slider-thumb { -webkit-appearance:none; width:14px; height:14px; background:var(--text-primary); border-radius:50%; cursor:pointer; box-shadow:0 4px 10px rgba(0,0,0,0.4); }
    .pan-label { font-size:10px; font-weight:600; color:var(--text-secondary); transform:translateZ(8px); }

    .fullscreen-exit-btn { position:fixed; top:14px; right:14px; z-index:2000; width:22px; height:22px; border-radius:50%; background:rgba(0,0,0,0.5); border:1px solid rgba(255,255,255,0.2); color:#fff; font-size:12px; cursor:pointer; display:none; align-items:center; justify-content:center; backdrop-filter:blur(6px); }

    /* ========== 专业版 ========== */
    #proUI { width:98vw; height:96vh; display:none; flex-direction:column; gap:8px; }
    .pro-glass { background:var(--pro-panel); backdrop-filter:blur(24px); -webkit-backdrop-filter:blur(24px); border:1px solid var(--pro-border); border-radius:6px; box-shadow:0 20px 50px rgba(0,0,0,0.7); flex:1; display:flex; flex-direction:column; overflow:hidden; }
    .pro-main { display:flex; gap:8px; padding:8px; flex:1; min-height:0; }
    .pro-viz { flex:2; display:flex; flex-direction:column; gap:8px; min-width:0; }
    .pro-viz-box { flex:1; background:#000; border-radius:4px; border:1px solid var(--pro-border); position:relative; overflow:hidden; }
    .pro-canvas { width:100%; height:100%; display:block; }
    .pro-mode-bar { position:absolute; top:8px; right:8px; display:flex; gap:4px; z-index:10; }
    .pro-mode-btn { background:rgba(0,0,0,0.6); border:1px solid rgba(255,255,255,0.2); color:#aaa; padding:4px 10px; border-radius:3px; font-size:12px; font-family:var(--font-mono); cursor:pointer; transition:all 0.15s; }
    .pro-mode-btn.active { background:var(--pro-accent); color:#000; border-color:var(--pro-accent); }
    .pro-ctrl { flex:1; display:flex; flex-direction:column; gap:8px; min-width:320px; max-width:480px; }
    .pro-info { background:rgba(0,0,0,0.4); border-radius:4px; padding:10px 14px; border:1px solid var(--pro-border); }
    .pro-title { font-size:18px; font-weight:600; font-family:var(--font-mono); color:var(--pro-text); }
    .pro-artist { font-size:12px; color:var(--pro-secondary); margin-top:4px; }
    .pro-progress { height:4px; background:rgba(255,255,255,0.1); border-radius:2px; margin:8px 0; cursor:pointer; position:relative; }
    .pro-progress-fill { height:100%; background:var(--pro-accent); border-radius:2px; width:0%; box-shadow:0 0 6px var(--pro-accent); }
    .meter-row { display:flex; gap:12px; margin-top:8px; }
    .meter { flex:1; background:#111; border-radius:2px; height:14px; position:relative; overflow:hidden; border:1px solid #333; }
    .meter-bar { height:100%; background:#0f0; transition:width 0.05s linear; }
    .meter-peak { position:absolute; top:0; right:0; height:100%; width:2px; background:#f00; }
    .meter-label { font-size:10px; color:var(--pro-secondary); margin-bottom:2px; }
    .pro-tabs { display:flex; gap:4px; margin:4px 0; }
    .pro-tab { flex:1; text-align:center; padding:6px; background:rgba(255,255,255,0.04); border-radius:3px; font-size:11px; font-weight:600; letter-spacing:0.5px; cursor:pointer; color:var(--pro-secondary); }
    .pro-tab.active { background:var(--pro-accent); color:#000; }
    .pro-scroll { flex:1; overflow-y:auto; border-radius:4px; background:rgba(0,0,0,0.3); padding:8px; }
    .pro-controls { display:flex; align-items:center; gap:12px; padding:8px; border-top:1px solid var(--pro-border); }
    .pro-btn { background:rgba(255,255,255,0.06); border:none; color:var(--pro-text); width:34px; height:34px; border-radius:4px; display:flex; align-items:center; justify-content:center; cursor:pointer; font-size:16px; }
    .pro-btn:hover { background:rgba(255,255,255,0.15); }
    .pro-pan-slider { width:100px; -webkit-appearance:none; height:5px; background:rgba(255,255,255,0.1); border-radius:2px; outline:none; }
    .pro-pan-slider::-webkit-slider-thumb { -webkit-appearance:none; width:16px; height:16px; background:var(--pro-accent); cursor:pointer; }
    .fx-slider-group { display:flex; flex-direction:column; gap:12px; padding:8px 0; }
    .fx-row { display:flex; align-items:center; gap:10px; }
    .fx-label { width:60px; font-size:12px; font-weight:600; color:var(--pro-secondary); text-align:right; }
    .fx-slider { flex:1; -webkit-appearance:none; height:4px; background:rgba(255,255,255,0.1); border-radius:2px; outline:none; }
    .fx-slider::-webkit-slider-thumb { -webkit-appearance:none; width:14px; height:14px; background:var(--pro-accent); cursor:pointer; }
    .fx-value { width:40px; font-size:11px; color:var(--pro-text); text-align:left; font-family:var(--font-mono); }

    @media (max-width:800px) {
      .layer-viz { height:200px; }
      .layer-middle { flex-direction:column; }
      .layer-info { flex:0 0 auto; }
      .layer-controls { gap:8px; }
      .ctrl-btn { width:36px; height:36px; font-size:15px; }
      .play-btn { width:46px; height:46px; }
      .pro-main { flex-direction:column; }
      .pro-viz { height:40vh; }
      .pro-ctrl { max-width:none; }
    }
  </style>
</head>
<body class="light-theme">
  <div class="bg-orb bg-orb--1"></div>
  <div class="bg-orb bg-orb--2"></div>
  <div class="bg-orb bg-orb--3"></div>
  <div class="bg-orb bg-orb--4"></div>

  <div class="app-stage" id="appStage">
    <!-- 经典版3D分层 -->
    <div id="classicUI">
      <div class="layer-base"></div>

      <div class="layer-viz" id="vizLayer">
        <canvas id="vizCanvas"></canvas>
        <div class="viz-mode-selector">
          <button class="viz-mode-btn active" data-mode="spectrum">📊</button>
          <button class="viz-mode-btn" data-mode="wave">〰️</button>
          <button class="viz-mode-btn" data-mode="circle">⭕</button>
          <button class="fullscreen-btn" id="btnFullscreen" title="全屏可视化">⛶</button>
        </div>
      </div>

      <div class="layer-middle">
        <div class="layer-info">
          <div class="track-title" id="trackTitle">旋律Pro</div>
          <div class="track-artist" id="trackArtist">准备就绪</div>
          <div class="track-meta"><span id="bitrateInfo">-- kbps</span><span id="sampleRateInfo">-- kHz</span></div>
          <div class="progress-box">
            <div class="time-row"><span id="timeCurrent">0:00</span><span id="timeDuration">0:00</span></div>
            <div class="progress-bar" id="progressBar"><div class="progress-fill" id="progressFill"></div></div>
          </div>
        </div>
        <div class="layer-right">
          <div class="tabs-row">
            <button class="tab-btn active" data-tab="playlist">播放列表</button>
            <button class="tab-btn" data-tab="lyrics">歌词</button>
          </div>
          <div class="tab-content" id="tabContent"></div>
        </div>
      </div>

      <div class="layer-eq" id="eqPanel"></div>

      <div class="layer-controls">
        <button class="ctrl-btn" id="btnMode">🔁</button>
        <button class="ctrl-btn" id="btnPrev">⏮️</button>
        <button class="ctrl-btn play-btn" id="btnPlay">▶️</button>
        <button class="ctrl-btn" id="btnNext">⏭️</button>
        <button class="ctrl-btn" id="btnImport">📁</button>
        <button class="ctrl-btn" id="btnLightDark">☀️</button>
        <button class="ctrl-btn" id="btnPro" title="专业版">🔬</button>
        <span class="pan-label">L</span>
        <input type="range" class="pan-slider" id="panSlider" min="-1" max="1" step="0.01" value="0">
        <span class="pan-label">R</span>
      </div>
    </div>

    <!-- 专业版 -->
    <div id="proUI">
      <div class="pro-glass">
        <div class="pro-main">
          <div class="pro-viz">
            <div class="pro-viz-box"><canvas class="pro-canvas" id="proCanvas"></canvas>
              <div class="pro-mode-bar">
                <button class="pro-mode-btn active" data-mode="spectrum">频谱</button>
                <button class="pro-mode-btn" data-mode="wave">波形</button>
                <button class="pro-mode-btn" data-mode="phase">相位</button>
                <button class="pro-mode-btn" data-mode="waterfall">瀑布</button>
              </div>
            </div>
          </div>
          <div class="pro-ctrl">
            <div class="pro-info">
              <div class="pro-title" id="proTitle">未加载音频</div>
              <div class="pro-artist" id="proArtist">--</div>
              <div class="pro-progress" id="proProgressBar"><div class="pro-progress-fill" id="proProgressFill"></div></div>
              <div class="meter-row">
                <div><div class="meter-label">L</div><div class="meter" id="meterL"><div class="meter-bar"></div><div class="meter-peak"></div></div></div>
                <div><div class="meter-label">R</div><div class="meter" id="meterR"><div class="meter-bar"></div><div class="meter-peak"></div></div></div>
              </div>
            </div>
            <div class="pro-tabs">
              <button class="pro-tab active" data-tab="fx">效果器</button>
              <button class="pro-tab" data-tab="eq">均衡器</button>
              <button class="pro-tab" data-tab="playlist">列表</button>
            </div>
            <div class="pro-scroll" id="proTabContent"></div>
          </div>
        </div>
        <div class="pro-controls">
          <button class="pro-btn" id="proPrev">⏮</button>
          <button class="pro-btn" id="proPlay">▶</button>
          <button class="pro-btn" id="proNext">⏭</button>
          <button class="pro-btn" id="proImport">📂</button>
          <span style="font-size:11px;color:var(--pro-secondary);">L</span>
          <input type="range" class="pro-pan-slider" id="proPan" min="-1" max="1" step="0.01" value="0">
          <span style="font-size:11px;color:var(--pro-secondary);">R</span>
          <button class="pro-btn" id="proBack">← 返回</button>
        </div>
      </div>
    </div>
  </div>

  <button class="fullscreen-exit-btn" id="btnExitFullscreen" title="退出全屏 (ESC)">✕</button>
  <input type="file" id="fileInput" accept="audio/*,video/*,.mp3,.wav,.flac,.m4a,.ogg,.aac,.wma,.opus,.weba,.mp4,.webm,.mov,.avi,.mkv" multiple style="display:none">
  <input type="file" id="lrcInput" accept=".lrc" style="display:none">
  <audio id="audio" preload="auto" crossorigin="anonymous"></audio>

  <script>
  (() => {
    const classicUI = document.getElementById('classicUI');
    const proUI = document.getElementById('proUI');
    const vizCanvas = document.getElementById('vizCanvas');
    const ctx = vizCanvas.getContext('2d');
    const trackTitle = document.getElementById('trackTitle');
    const trackArtist = document.getElementById('trackArtist');
    const bitrateInfo = document.getElementById('bitrateInfo');
    const sampleRateInfo = document.getElementById('sampleRateInfo');
    const timeCurrent = document.getElementById('timeCurrent');
    const timeDuration = document.getElementById('timeDuration');
    const progressFill = document.getElementById('progressFill');
    const progressBar = document.getElementById('progressBar');
    const tabContent = document.getElementById('tabContent');
    const btnPlay = document.getElementById('btnPlay');
    const btnMode = document.getElementById('btnMode');
    const btnPrev = document.getElementById('btnPrev');
    const btnNext = document.getElementById('btnNext');
    const btnImport = document.getElementById('btnImport');
    const btnLightDark = document.getElementById('btnLightDark');
    const btnPro = document.getElementById('btnPro');
    const btnFullscreen = document.getElementById('btnFullscreen');
    const btnExitFullscreen = document.getElementById('btnExitFullscreen');
    const panSlider = document.getElementById('panSlider');
    const fileInput = document.getElementById('fileInput');
    const lrcInput = document.getElementById('lrcInput');
    const audio = document.getElementById('audio');
    const eqPanel = document.getElementById('eqPanel');

    const proCanvas = document.getElementById('proCanvas');
    const proCtx = proCanvas.getContext('2d');
    const proTitle = document.getElementById('proTitle');
    const proArtist = document.getElementById('proArtist');
    const proProgressFill = document.getElementById('proProgressFill');
    const proProgressBar = document.getElementById('proProgressBar');
    const proTabContent = document.getElementById('proTabContent');
    const proPlay = document.getElementById('proPlay');
    const proPrev = document.getElementById('proPrev');
    const proNext = document.getElementById('proNext');
    const proImport = document.getElementById('proImport');
    const proBack = document.getElementById('proBack');
    const proPan = document.getElementById('proPan');
    const meterL = document.getElementById('meterL')?.querySelector('.meter-bar');
    const meterR = document.getElementById('meterR')?.querySelector('.meter-bar');

    let playlist = [], currentIndex = -1, isPlaying = false;
    let audioCtx = null, analyser = null, leftAnalyser = null, rightAnalyser = null;
    let splitter = null, merger = null, source = null;
    let pannerNode = null, gainNode = null, eqFilters = [];
    let dryGain = null, wetGain = null, reverbCore = null;
    const eqFreqs = [32,64,125,250,500,1000,2000,4000,8000,16000];
    let classicAnimId = null, proAnimId = null;
    let vizMode = 'spectrum', proVizMode = 'spectrum';
    let currentTab = 'playlist', proCurrentTab = 'fx';
    let lyrics = [];
    const defaultTheme = { hue:210, range:40 };
    let modeIdx = 0;
    const modes = ['🔁','🔂','🔀'];
    let isLight = true, isFullscreen = false, isProMode = false;
    let waterfallData = [];
    let reverbSettings = { roomSize:0.5, decay:0.5, mix:0.3 };

    // 3D拖拽
    let isDragging3D = false, startX = 0, startY = 0;
    let rotY = 0, rotX = 0, velY = 0, velX = 0;

    function animate3D() {
      if (!isDragging3D && !isProMode && !isFullscreen) {
        rotX += velX; rotY += velY;
        velX *= 0.9; velY *= 0.9;
        rotX += (0 - rotX) * 0.03; rotY += (0 - rotY) * 0.03;
      }
      if (!isProMode && !isFullscreen) {
        classicUI.style.transform = `rotateY(${rotY}deg) rotateX(${rotX}deg)`;
      }
      requestAnimationFrame(animate3D);
    }

    document.addEventListener('mousedown', e => {
      if (isProMode || isFullscreen) return;
      if (e.target.closest('button,input,.playlist-item,.tab-btn,.progress-bar')) return;
      isDragging3D = true; const t = e; startX = t.clientX; startY = t.clientY; velX = 0; velY = 0;
    });
    document.addEventListener('mousemove', e => {
      if (!isDragging3D) return;
      const dx = e.clientX - startX, dy = e.clientY - startY;
      rotY += dx * 0.15; rotX -= dy * 0.1;
      velY = dy * 0.015; velX = dx * 0.015;
      startX = e.clientX; startY = e.clientY;
    });
    document.addEventListener('mouseup', () => { isDragging3D = false; });
    document.addEventListener('touchstart', e => {
      if (isProMode || isFullscreen) return;
      if (e.target.closest('button,input,.playlist-item,.tab-btn,.progress-bar')) return;
      isDragging3D = true; const t = e.touches[0]; startX = t.clientX; startY = t.clientY; velX = 0; velY = 0;
    }, {passive:false});
    document.addEventListener('touchmove', e => {
      if (!isDragging3D) return;
      e.preventDefault();
      const t = e.touches[0]; const dx = t.clientX - startX, dy = t.clientY - startY;
      rotY += dx * 0.15; rotX -= dy * 0.1;
      velY = dy * 0.015; velX = dx * 0.015;
      startX = t.clientX; startY = t.clientY;
    }, {passive:false});
    document.addEventListener('touchend', () => { isDragging3D = false; });

    btnLightDark.addEventListener('click', () => { if(isProMode)return; isLight=!isLight; document.body.classList.toggle('light-theme',isLight); btnLightDark.textContent=isLight?'☀️':'🌓'; });

    function switchToPro() {
      isProMode=true; classicUI.style.display='none'; proUI.style.display='flex'; document.body.classList.remove('light-theme');
      if(isFullscreen)exitFullscreen(); proTitle.textContent=trackTitle.textContent; proArtist.textContent=trackArtist.textContent;
      proPan.value=panSlider.value; proPlay.textContent=isPlaying?'⏸':'▶'; renderProTab(); resizeProCanvas();
      if(classicAnimId)cancelAnimationFrame(classicAnimId); drawPro();
    }
    function switchToClassic() {
      isProMode=false; classicUI.style.display=''; proUI.style.display='none'; document.body.classList.add('light-theme');
      if(!isLight)document.body.classList.remove('light-theme'); panSlider.value=proPan.value;
      if(proAnimId)cancelAnimationFrame(proAnimId); resizeCanvas(); draw();
    }
    btnPro.addEventListener('click',switchToPro); proBack.addEventListener('click',switchToClassic);

    function enterFullscreen() {
      if(isFullscreen||isProMode)return; isFullscreen=true;
      vizCanvas.style.position='fixed'; vizCanvas.style.top='0'; vizCanvas.style.left='0';
      vizCanvas.style.width='100vw'; vizCanvas.style.height='100vh'; vizCanvas.style.zIndex='1500'; vizCanvas.style.borderRadius='0';
      document.body.appendChild(vizCanvas); classicUI.style.opacity='0'; btnExitFullscreen.style.display='flex'; resizeCanvas();
    }
    function exitFullscreen() {
      if(!isFullscreen)return; isFullscreen=false;
      vizCanvas.style.position='absolute'; vizCanvas.style.top='0'; vizCanvas.style.left='0';
      vizCanvas.style.width='100%'; vizCanvas.style.height='100%'; vizCanvas.style.zIndex=''; vizCanvas.style.borderRadius='var(--radius-lg)';
      document.getElementById('vizLayer').appendChild(vizCanvas); classicUI.style.opacity='1'; btnExitFullscreen.style.display='none'; resizeCanvas();
    }
    btnFullscreen.addEventListener('click',enterFullscreen); btnExitFullscreen.addEventListener('click',exitFullscreen);
    document.addEventListener('keydown',e=>{if(e.key==='Escape'&&isFullscreen){e.preventDefault();exitFullscreen();}});

    function createReverbCore(ctx){const input=ctx.createGain(),output=ctx.createGain(),preDelay=ctx.createDelay(1);preDelay.delayTime.value=0.02;input.connect(preDelay);const cbd=[0.05,0.06,0.07,0.08],cbf=[0.7,0.6,0.5,0.4];const cd=[],cf=[],co=[];cbd.forEach((d,i)=>{const delay=ctx.createDelay(1),fb=ctx.createGain(),ff=ctx.createGain();delay.delayTime.value=d;fb.gain.value=cbf[i];preDelay.connect(delay);delay.connect(fb);delay.connect(ff);fb.connect(delay);cd.push(delay);cf.push(fb);co.push(ff);});const apd=[0.005,0.0017];let api=ctx.createGain();co.forEach(o=>o.connect(api));const ad=[],afb=[];apd.forEach(d=>{const delay=ctx.createDelay(1),fb=ctx.createGain(),ff=ctx.createGain(),apOut=ctx.createGain();delay.delayTime.value=d;fb.gain.value=0.5;ff.gain.value=0.5;api.connect(delay);api.connect(ff);delay.connect(fb);fb.connect(delay);fb.connect(apOut);ff.connect(apOut);ad.push(delay);afb.push(fb);api=apOut;});api.connect(output);return{input,output,setRoomSize(v){const s=1+v*1.5;cd.forEach((n,i)=>{n.delayTime.value=cbd[i]*s;});ad.forEach((n,i)=>{n.delayTime.value=apd[i]*s;});},setDecay(v){cf.forEach((n,i)=>{n.gain.value=cbf[i]*v;});}};}

    async function initAudioGraph(){
      if(audioCtx&&audioCtx.state!=='closed')await audioCtx.close();
      audioCtx=new AudioContext();analyser=audioCtx.createAnalyser();analyser.fftSize=2048;analyser.smoothingTimeConstant=0.8;
      splitter=audioCtx.createChannelSplitter(2);merger=audioCtx.createChannelMerger(2);
      leftAnalyser=audioCtx.createAnalyser();rightAnalyser=audioCtx.createAnalyser();
      leftAnalyser.fftSize=256;rightAnalyser.fftSize=256;leftAnalyser.smoothingTimeConstant=0.2;rightAnalyser.smoothingTimeConstant=0.2;
      pannerNode=audioCtx.createStereoPanner();gainNode=audioCtx.createGain();source=audioCtx.createMediaElementSource(audio);
      source.connect(analyser);analyser.connect(splitter);splitter.connect(leftAnalyser,0);splitter.connect(rightAnalyser,1);
      leftAnalyser.connect(merger,0,0);rightAnalyser.connect(merger,0,1);merger.connect(pannerNode);pannerNode.connect(gainNode);
      dryGain=audioCtx.createGain();wetGain=audioCtx.createGain();reverbCore=createReverbCore(audioCtx);
      gainNode.connect(dryGain);gainNode.connect(wetGain);
      eqFilters=eqFreqs.map(f=>{const fl=audioCtx.createBiquadFilter();fl.type='peaking';fl.frequency.value=f;fl.Q.value=1;fl.gain.value=0;return fl;});
      dryGain.connect(eqFilters[0]);reverbCore.output.connect(eqFilters[0]);
      for(let i=0;i<eqFilters.length-1;i++)eqFilters[i].connect(eqFilters[i+1]);eqFilters[eqFilters.length-1].connect(audioCtx.destination);
      pannerNode.pan.value=parseFloat(panSlider.value);gainNode.gain.value=1;applyReverbSettings();createEQSliders();
    }
    function applyReverbSettings(){if(!reverbCore||!dryGain||!wetGain)return;const{roomSize,decay,mix}=reverbSettings;reverbCore.setRoomSize(roomSize);reverbCore.setDecay(decay);dryGain.gain.value=1-mix*0.8;wetGain.gain.value=mix*0.8;}
    function createEQSliders(){eqPanel.innerHTML='';eqFreqs.forEach((f,i)=>{const g=document.createElement('div');g.className='eq-slider-group';const l=document.createElement('span');l.className='eq-label';l.textContent=f>=1000?(f/1000).toFixed(0)+'k':f;const s=document.createElement('input');s.type='range';s.min=-12;s.max=12;s.value=0;s.step=0.5;s.className='eq-slider';s.addEventListener('input',()=>{if(eqFilters[i])eqFilters[i].gain.value=parseFloat(s.value);});g.appendChild(s);g.appendChild(l);eqPanel.appendChild(g);});}

    function loadTrack(idx){if(idx<0||idx>=playlist.length)return;currentIndex=idx;audio.src=playlist[idx].blobUrl;audio.load();updateTrackInfo();renderPlaylist();if(!audioCtx){initAudioGraph().then(()=>{if(isPlaying)audio.play().catch(()=>{});});}else{if(isPlaying)audio.play().catch(()=>{});}}
    function togglePlay(){if(!playlist.length){fileInput.click();return;}if(currentIndex<0)loadTrack(0);if(isPlaying)audio.pause();else audio.play().catch(()=>{});}
    function next(){if(!playlist.length)return;let nxt;if(modeIdx===2)nxt=Math.floor(Math.random()*playlist.length);else{nxt=currentIndex+1;if(nxt>=playlist.length)nxt=modeIdx===1?currentIndex:0;}if(nxt>=0&&nxt<playlist.length){loadTrack(nxt);if(isPlaying)audio.play().catch(()=>{});}}
    function prev(){if(!playlist.length)return;if(audio.currentTime>2){audio.currentTime=0;if(!isPlaying)audio.play().catch(()=>{});return;}let prv=modeIdx===2?Math.floor(Math.random()*playlist.length):currentIndex-1;if(prv<0)prv=modeIdx===1?currentIndex:playlist.length-1;if(prv>=0&&prv<playlist.length){loadTrack(prv);if(isPlaying)audio.play().catch(()=>{});}}
    function updatePlayBtn(){btnPlay.textContent=isPlaying?'⏸️':'▶️';proPlay.textContent=isPlaying?'⏸':'▶';}
    audio.onplay=()=>{isPlaying=true;updatePlayBtn();};audio.onpause=()=>{isPlaying=false;updatePlayBtn();};
    audio.onended=()=>{if(modeIdx===1&&currentIndex>=0){audio.currentTime=0;audio.play().catch(()=>{});}else next();};
    function updateTrackInfo(){if(currentIndex>=0){const t=playlist[currentIndex];trackTitle.textContent=t.title;trackArtist.textContent=t.artist||'未知艺术家';proTitle.textContent=t.title;proArtist.textContent=t.artist||'未知';bitrateInfo.textContent=t.bitrate?`${t.bitrate} kbps`:'-- kbps';sampleRateInfo.textContent=t.sampleRate?`${(t.sampleRate/1000).toFixed(1)} kHz`:'-- kHz';}else{trackTitle.textContent='旋律Pro';trackArtist.textContent='准备就绪';proTitle.textContent='未加载音频';proArtist.textContent='--';bitrateInfo.textContent='-- kbps';sampleRateInfo.textContent='-- kHz';}}

    function renderPlaylist(){const container=isProMode?proTabContent:tabContent;if(isProMode&&proCurrentTab!=='playlist')return;if(!isProMode&&currentTab!=='playlist')return;container.innerHTML='';if(!playlist.length){container.innerHTML='<div style="text-align:center;color:var(--text-secondary);padding:30px;">📂 导入音乐或视频</div>';return;}playlist.forEach((t,i)=>{const d=document.createElement('div');d.className='playlist-item'+(i===currentIndex?' active':'');d.innerHTML=`<span class="playlist-item-type">${t.isVideo?'🎬':'🎵'}</span><span class="playlist-item-index">${i+1}</span><div class="playlist-item-info"><div class="playlist-item-title">${escapeHtml(t.title)}</div><div class="playlist-item-artist">${escapeHtml(t.artist||'—')}</div></div><span class="playlist-item-duration">${fmtTime(t.duration)}</span><button class="playlist-item-del" data-idx="${i}">×</button>`;d.addEventListener('click',e=>{if(!e.target.classList.contains('playlist-item-del')){loadTrack(i);audio.play().catch(()=>{});}});d.querySelector('.playlist-item-del').addEventListener('click',e=>{e.stopPropagation();removeTrack(i);});container.appendChild(d);});}
    function renderProTab(){proTabContent.innerHTML='';if(proCurrentTab==='playlist'){renderPlaylist();}else if(proCurrentTab==='eq'){const eqDiv=document.createElement('div');eqDiv.style.cssText='display:flex;flex-wrap:wrap;gap:12px;justify-content:center;';eqFreqs.forEach((f,i)=>{const g=document.createElement('div');g.style.cssText='display:flex;flex-direction:column;align-items:center;gap:4px;';const l=document.createElement('span');l.textContent=f>=1000?(f/1000).toFixed(0)+'k':f;l.style.cssText='font-size:11px;color:var(--pro-secondary);font-family:var(--font-mono);';const s=document.createElement('input');s.type='range';s.min=-12;s.max=12;s.value=eqFilters[i]?eqFilters[i].gain.value:0;s.step=0.5;s.style.width='80px';s.addEventListener('input',()=>{if(eqFilters[i])eqFilters[i].gain.value=parseFloat(s.value);});g.appendChild(s);g.appendChild(l);eqDiv.appendChild(g);});proTabContent.appendChild(eqDiv);}else{const c=document.createElement('div');c.className='fx-slider-group';[{id:'roomSize',label:'房间大小',min:0,max:1,step:0.01,value:reverbSettings.roomSize},{id:'decay',label:'衰减',min:0,max:1,step:0.01,value:reverbSettings.decay},{id:'mix',label:'干湿比',min:0,max:1,step:0.01,value:reverbSettings.mix}].forEach(p=>{const r=document.createElement('div');r.className='fx-row';const lb=document.createElement('span');lb.className='fx-label';lb.textContent=p.label;const sl=document.createElement('input');sl.type='range';sl.className='fx-slider';sl.min=p.min;sl.max=p.max;sl.step=p.step;sl.value=p.value;const v=document.createElement('span');v.className='fx-value';v.textContent=Math.round(p.value*100)+'%';sl.addEventListener('input',()=>{const val=parseFloat(sl.value);reverbSettings[p.id]=val;v.textContent=Math.round(val*100)+'%';applyReverbSettings();});r.appendChild(lb);r.appendChild(sl);r.appendChild(v);c.appendChild(r);});proTabContent.appendChild(c);}}

    function removeTrack(idx){if(idx<0||idx>=playlist.length)return;if(playlist[idx].blobUrl)URL.revokeObjectURL(playlist[idx].blobUrl);const w=idx===currentIndex;playlist.splice(idx,1);if(!playlist.length){currentIndex=-1;isPlaying=false;audio.pause();audio.src='';updatePlayBtn();updateTrackInfo();renderPlaylist();return;}if(w){currentIndex=Math.min(idx,playlist.length-1);loadTrack(currentIndex);if(isPlaying)audio.play().catch(()=>{});}else if(idx<currentIndex)currentIndex--;updateTrackInfo();renderPlaylist();}
    function isVideoFile(n){return/\.(mp4|webm|mov|avi|mkv|flv|wmv)$/i.test(n);}
    function addFiles(files){const v=[...files].filter(f=>/\.(mp3|wav|flac|m4a|ogg|aac|wma|opus|weba|mp4|webm|mov|avi|mkv|flv|wmv)$/i.test(f.name));if(!v.length)return;v.forEach(file=>{const url=URL.createObjectURL(file);const p=parseFilename(file.name);playlist.push({id:Date.now()+Math.random(),file,blobUrl:url,title:p.title,artist:p.artist,duration:0,bitrate:null,sampleRate:null,isVideo:isVideoFile(file.name)});const t=new Audio();t.preload='metadata';t.src=url;t.addEventListener('loadedmetadata',()=>{const tr=playlist.find(x=>x.blobUrl===url);if(tr){tr.duration=t.duration||0;if(file.size&&t.duration)tr.bitrate=Math.round(file.size*8/t.duration/1000);tr.sampleRate=audioCtx?audioCtx.sampleRate:44100;t.src='';if(currentIndex===playlist.indexOf(tr))updateTrackInfo();renderPlaylist();}},{once:true});t.addEventListener('error',()=>{t.src='';renderPlaylist();},{once:true});});renderPlaylist();if(currentIndex<0&&playlist.length){loadTrack(0);updateTrackInfo();}}
    function parseFilename(n){n=n.replace(/\.(mp3|wav|flac|m4a|ogg|aac|wma|opus|weba|mp4|webm|mov|avi|mkv|flv|wmv)$/i,'');const s=[' - ',' – ',' — ','-','–','—'];for(const sep of s){const i=n.indexOf(sep);if(i>0)return{title:n.substring(i+sep.length).trim(),artist:n.substring(0,i).trim()};}return{title:n.trim(),artist:''};}
    function escapeHtml(s){const d=document.createElement('div');d.textContent=s;return d.innerHTML;}
    function fmtTime(s){if(!isFinite(s)||s<0)return'0:00';const m=Math.floor(s/60),sec=Math.floor(s%60);return`${m}:${sec.toString().padStart(2,'0')}`;}

    progressBar.addEventListener('click',e=>{if(!playlist.length||currentIndex<0)return;const r=progressBar.getBoundingClientRect();const ratio=Math.max(0,Math.min(1,(e.clientX-r.left)/r.width));audio.currentTime=ratio*audio.duration;});
    proProgressBar.addEventListener('click',e=>{if(!playlist.length||currentIndex<0)return;const r=proProgressBar.getBoundingClientRect();const ratio=Math.max(0,Math.min(1,(e.clientX-r.left)/r.width));audio.currentTime=ratio*audio.duration;});
    audio.addEventListener('timeupdate',()=>{if(audio.duration){const p=audio.currentTime/audio.duration*100;progressFill.style.width=p+'%';proProgressFill.style.width=p+'%';timeCurrent.textContent=fmtTime(audio.currentTime);timeDuration.textContent=fmtTime(audio.duration);}});

    btnPlay.addEventListener('click',togglePlay);proPlay.addEventListener('click',togglePlay);
    btnPrev.addEventListener('click',prev);proPrev.addEventListener('click',prev);
    btnNext.addEventListener('click',next);proNext.addEventListener('click',next);
    btnImport.addEventListener('click',()=>fileInput.click());proImport.addEventListener('click',()=>fileInput.click());
    btnMode.addEventListener('click',()=>{modeIdx=(modeIdx+1)%3;btnMode.textContent=modes[modeIdx];});
    fileInput.addEventListener('change',e=>{if(e.target.files.length){addFiles(e.target.files);fileInput.value='';}});
    panSlider.addEventListener('input',()=>{const v=parseFloat(panSlider.value);proPan.value=v;if(pannerNode)pannerNode.pan.value=v;});
    proPan.addEventListener('input',()=>{const v=parseFloat(proPan.value);panSlider.value=v;if(pannerNode)pannerNode.pan.value=v;});
    document.querySelectorAll('.viz-mode-btn').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.viz-mode-btn').forEach(x=>x.classList.remove('active'));b.classList.add('active');vizMode=b.dataset.mode;}));
    document.querySelectorAll('.pro-mode-btn').forEach(b=>b.addEventListener('click',()=>{document.querySelectorAll('.pro-mode-btn').forEach(x=>x.classList.remove('active'));b.classList.add('active');proVizMode=b.dataset.mode;}));
    document.querySelectorAll('.pro-tab').forEach(t=>t.addEventListener('click',()=>{document.querySelectorAll('.pro-tab').forEach(x=>x.classList.remove('active'));t.classList.add('active');proCurrentTab=t.dataset.tab;renderProTab();}));
    document.querySelectorAll('.tab-btn').forEach(t=>t.addEventListener('click',()=>{document.querySelectorAll('.tab-btn').forEach(x=>x.classList.remove('active'));t.classList.add('active');currentTab=t.dataset.tab;if(currentTab==='playlist')renderPlaylist();else renderLyrics();}));
    function renderLyrics(){tabContent.innerHTML='';if(!lyrics.length){tabContent.innerHTML='<div style="text-align:center;color:var(--text-secondary);padding:30px;">📝 拖入.lrc歌词文件</div>';return;}lyrics.forEach((l,i)=>{const d=document.createElement('div');d.className='lyric-line';d.textContent=l.text;d.dataset.index=i;tabContent.appendChild(d);});}
    function parseLrc(t){const ls=t.split('\n');const p=[];const r=/\[(\d{2}):(\d{2})\.(\d{2,3})\]/g;ls.forEach(l=>{const m=[...l.matchAll(r)];if(!m.length)return;const c=l.replace(r,'').trim();m.forEach(x=>{const min=parseInt(x[1]),sec=parseInt(x[2]),ms=parseInt(x[3].padEnd(3,'0'));p.push({time:min*60+sec+ms/1000,text:c});});});p.sort((a,b)=>a.time-b.time);return p;}
    lrcInput.addEventListener('change',e=>{const f=e.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{lyrics=parseLrc(r.result);if(currentTab==='lyrics')renderLyrics();};r.readAsText(f);lrcInput.value='';});

    function resizeCanvas(){const dpr=Math.min(devicePixelRatio||1,2);let w,h;if(isFullscreen){w=window.innerWidth;h=window.innerHeight;}else{const r=vizCanvas.parentElement.getBoundingClientRect();w=r.width;h=r.height;}if(vizCanvas.width!==w*dpr||vizCanvas.height!==h*dpr){vizCanvas.width=w*dpr;vizCanvas.height=h*dpr;vizCanvas.style.width=w+'px';vizCanvas.style.height=h+'px';ctx.setTransform(1,0,0,1,0,0);ctx.scale(dpr,dpr);}}
    function resizeProCanvas(){const dpr=Math.min(devicePixelRatio||1,2);const r=proCanvas.parentElement.getBoundingClientRect();if(proCanvas.width!==r.width*dpr||proCanvas.height!==r.height*dpr){proCanvas.width=r.width*dpr;proCanvas.height=r.height*dpr;proCanvas.style.width=r.width+'px';proCanvas.style.height=r.height+'px';proCtx.setTransform(1,0,0,1,0,0);proCtx.scale(dpr,dpr);}}

    function draw(){if(isProMode)return;resizeCanvas();const w=isFullscreen?window.innerWidth:vizCanvas.parentElement.clientWidth;const h=isFullscreen?window.innerHeight:vizCanvas.parentElement.clientHeight;if(w===0||h===0){classicAnimId=requestAnimationFrame(draw);return;}ctx.clearRect(0,0,w,h);if(!analyser||currentIndex<0){classicAnimId=requestAnimationFrame(draw);return;}const freq=new Uint8Array(analyser.frequencyBinCount);analyser.getByteFrequencyData(freq);const time=new Uint8Array(analyser.fftSize);analyser.getByteTimeDomainData(time);if(vizMode==='spectrum')drawSpectrum(w,h,freq);else if(vizMode==='wave')drawWave(w,h,time);else if(vizMode==='circle')drawCircle(w,h,freq);classicAnimId=requestAnimationFrame(draw);}
    function drawPro(){if(!isProMode)return;resizeProCanvas();const w=proCanvas.parentElement.clientWidth;const h=proCanvas.parentElement.clientHeight;proCtx.clearRect(0,0,w,h);if(!analyser||currentIndex<0){proAnimId=requestAnimationFrame(drawPro);return;}const freq=new Uint8Array(analyser.frequencyBinCount);analyser.getByteFrequencyData(freq);const time=new Uint8Array(analyser.fftSize);analyser.getByteTimeDomainData(time);if(proVizMode==='spectrum')drawProSpectrum(w,h,freq);else if(proVizMode==='wave')drawProWave(w,h,time);else if(proVizMode==='phase')drawProPhase(w,h);else if(proVizMode==='waterfall')drawProWaterfall(w,h,freq);updateMeters();proAnimId=requestAnimationFrame(drawPro);}

    function drawSpectrum(w,h,d){const bars=80;for(let i=0;i<bars;i++){const val=d[Math.floor(i*d.length/bars)]/255;const barH=val*h*0.8;const x=12+i*((w-24)/bars);ctx.fillStyle=`hsla(${defaultTheme.hue+i/bars*defaultTheme.range},80%,60%,${0.7+val*0.3})`;ctx.fillRect(x,h*0.9-barH,(w-24)/bars-2,barH);}}
    function drawWave(w,h,d){ctx.beginPath();ctx.strokeStyle='#fff';ctx.lineWidth=2;const step=w/d.length;ctx.moveTo(0,h/2);for(let i=0;i<d.length;i++)ctx.lineTo(i*step,(d[i]/255)*h);ctx.stroke();}
    function drawCircle(w,h,d){const cx=w/2,cy=h/2,r=Math.min(w,h)*0.4;ctx.beginPath();ctx.arc(cx,cy,r+5,0,Math.PI*2);ctx.strokeStyle='#fff';ctx.stroke();for(let i=0;i<120;i++){const val=d[Math.floor(i*d.length/120)]/255;const angle=i/120*Math.PI*2;const radius=r+val*40;ctx.fillStyle=`hsla(${200+i*0.4},80%,70%,0.8)`;ctx.beginPath();ctx.arc(cx+Math.cos(angle)*radius,cy+Math.sin(angle)*radius,2,0,Math.PI*2);ctx.fill();}}
    function drawProSpectrum(w,h,d){const bars=128;for(let i=0;i<bars;i++){const val=d[Math.floor(i*d.length/bars)]/255;const barH=val*h*0.9;const x=i*(w/bars);proCtx.fillStyle=`hsla(${defaultTheme.hue+i/bars*defaultTheme.range},80%,60%,${0.7+val*0.3})`;proCtx.fillRect(x,h-barH,w/bars*0.8,barH);}}
    function drawProWave(w,h,d){proCtx.beginPath();proCtx.strokeStyle='#0cf';proCtx.lineWidth=2;const step=w/d.length;proCtx.moveTo(0,h/2);for(let i=0;i<d.length;i++)proCtx.lineTo(i*step,(d[i]/255)*h);proCtx.stroke();}
    function drawProPhase(w,h){const lD=new Uint8Array(leftAnalyser.fftSize),rD=new Uint8Array(rightAnalyser.fftSize);leftAnalyser.getByteTimeDomainData(lD);rightAnalyser.getByteTimeDomainData(rD);proCtx.clearRect(0,0,w,h);for(let i=0;i<lD.length;i+=4){proCtx.fillStyle='#0f0';proCtx.fillRect(lD[i]/255*w*0.4+w*0.1,lD[i+1]/255*h*0.4+h*0.3,2,2);proCtx.fillStyle='#f00';proCtx.fillRect(rD[i]/255*w*0.4+w*0.5,rD[i+1]/255*h*0.4+h*0.3,2,2);}}
    function drawProWaterfall(w,h,d){const s=d.slice(0,256);waterfallData.push(s);if(waterfallData.length>200)waterfallData.shift();for(let y=0;y<waterfallData.length;y++){for(let x=0;x<256;x++){const val=waterfallData[y][x]/255;proCtx.fillStyle=`hsla(${200-val*100},80%,50%,${val})`;proCtx.fillRect(x*(w/256),h-y*3,w/256,3);}}}
    function updateMeters(){if(!leftAnalyser||!meterL)return;const lD=new Uint8Array(leftAnalyser.fftSize),rD=new Uint8Array(rightAnalyser.fftSize);leftAnalyser.getByteTimeDomainData(lD);rightAnalyser.getByteTimeDomainData(rD);let lS=0,rS=0;for(let i=0;i<lD.length;i++){lS+=Math.abs(lD[i]-128);rS+=Math.abs(rD[i]-128);}meterL.style.width=(lS/lD.length/128*100)+'%';meterR.style.width=(rS/rD.length/128*100)+'%';}

    document.addEventListener('keydown',e=>{if(e.target.tagName==='INPUT'&&e.target.type!=='range')return;if(e.key==='Escape'&&isFullscreen){e.preventDefault();exitFullscreen();return;}switch(e.code){case'Space':e.preventDefault();togglePlay();break;case'ArrowLeft':audio.currentTime=Math.max(0,audio.currentTime-5);break;case'ArrowRight':audio.currentTime=Math.min(audio.duration||0,audio.currentTime+5);break;case'ArrowUp':e.preventDefault();if(gainNode)gainNode.gain.value=Math.min(2,gainNode.gain.value+0.1);break;case'ArrowDown':e.preventDefault();if(gainNode)gainNode.gain.value=Math.max(0,gainNode.gain.value-0.1);break;case'KeyN':next();break;case'KeyP':prev();break;}});
    document.addEventListener('dragover',e=>e.preventDefault());
    document.addEventListener('drop',e=>{e.preventDefault();if(e.dataTransfer.files.length){const lrc=[...e.dataTransfer.files].filter(f=>f.name.endsWith('.lrc'));if(lrc.length){const r=new FileReader();r.onload=()=>{lyrics=parseLrc(r.result);if(currentTab==='lyrics')renderLyrics();};r.readAsText(lrc[0]);}addFiles(e.dataTransfer.files);}});

    function init(){resizeCanvas();updatePlayBtn();updateTrackInfo();renderPlaylist();draw();animate3D();audio.volume=1;btnMode.textContent=modes[0];btnLightDark.textContent='☀️';}
    init();
    window.addEventListener('resize',()=>{resizeCanvas();resizeProCanvas();});
  })();
  </script>
</body>
</html>